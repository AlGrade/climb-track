.DS_Store
.idea/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
# Large generated artefacts in the project root only.
# Keep the leading slash: an unanchored `cache/` would also ignore the
# source package src/climbtrack/cache/.
/cache/
/data/
/models/
/outputs/
# Hand-made annotations are versioned; everything derived from them is not.
# `moves.parquet` is rewritten from `moves_ground_truth.json` on every save, and
# the evaluation reports are recomputed from ground truth plus the pose cache.
annotations/**/moves.parquet
annotations/**/evaluation*.json

